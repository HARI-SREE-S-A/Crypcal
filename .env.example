# CrypCal Environment Configuration
# Copy to .env and fill in values, or run: scripts/setup.ps1 (Windows) / scripts/setup.sh (Linux)

# =============================================================================
# Domain & Server
# =============================================================================
# For local dev: localhost
# For production: your.domain.com
CRYPCAL_DOMAIN=localhost
CRYPCAL_SERVER_NAME=localhost

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# =============================================================================
# Synapse (Matrix Homeserver)
# =============================================================================
SYNAPSE_REGISTRATION_SHARED_SECRET=CHANGE_ME_registration_shared_secret
SYNAPSE_MACAROON_SECRET_KEY=CHANGE_ME_macaroon_secret
SYNAPSE_FORM_SECRET=CHANGE_ME_form_secret

# =============================================================================
# coturn (TURN/STUN)
# =============================================================================
TURN_SHARED_SECRET=CHANGE_ME_turn_shared_secret
TURN_REALM=localhost

# =============================================================================
# LiveKit (SFU)
# =============================================================================
LIVEKIT_API_KEY=CHANGE_ME_livekit_api_key
LIVEKIT_API_SECRET=CHANGE_ME_livekit_api_secret

# =============================================================================
# TLS Mode
# =============================================================================
# "local" = self-signed certs for development
# "production" = Let's Encrypt via Caddy
TLS_MODE=local

# =============================================================================
# 192.168.6 Web Client & Supabase (Free 24/7 Hosting)
# =============================================================================
VITE_HOMESERVER_URL=https://matrix-client.matrix.org
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
VITE_ADMIN_PASSWORD=8907597543
