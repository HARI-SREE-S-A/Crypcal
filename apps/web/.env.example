# 192.168.6 Web Client Environment Variables
# Copy to .env.local for local overrides or set in Vercel Project Settings

# Matrix Homeserver base URL (defaults to matrix.org for free global hosting)
VITE_HOMESERVER_URL=https://matrix-client.matrix.org

# Supabase configuration for User Directory & Admin Approval
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Admin password for approving/rejecting user registration requests
VITE_ADMIN_PASSWORD=admin1921686
