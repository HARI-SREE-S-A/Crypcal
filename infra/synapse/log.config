version: 1

formatters:
  precise:
    format: '%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(message)s'

filters:
  context:
    (): synapse.util.logcontext.LoggingContextFilter
    request: ""

handlers:
  file:
    class: logging.handlers.TimedRotatingFileHandler
    formatter: precise
    filename: /data/homeserver.log
    when: midnight
    backupCount: 7
    encoding: utf8
  console:
    class: logging.StreamHandler
    formatter: precise
    stream: ext://sys.stdout
    filters: [context]

loggers:
  # Suppress noisy loggers
  synapse.storage.SQL:
    level: WARNING
  # Suppress access logs that may contain IPs
  synapse.access:
    level: WARNING
  synapse.http.server:
    level: WARNING
  # Suppress event content logging
  synapse.handlers.message:
    level: WARNING
  synapse.events:
    level: WARNING
  # Federation (disabled, but suppress just in case)
  synapse.federation:
    level: WARNING

root:
  level: INFO
  handlers: [file, console]

disable_existing_loggers: false
